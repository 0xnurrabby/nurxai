DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
# If your host/Vercel cannot reach Supabase direct IPv6 DB, use the Supabase pooler URL instead.
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
JWT_SECRET="generate_with: openssl rand -hex 64"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="864793946084-965591khsljsg2psoce7lakgik56gv33.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="864793946084-965591khsljsg2psoce7lakgik56gv33.apps.googleusercontent.com"
NOWPAYMENTS_API_KEY=""
# Legacy fallback still works if already set:
# NOWPAYMENTS_KEY=""
NOWPAYMENTS_IPN_SECRET=""
PUBLIC_URL="https://www.nurxai.xyz"

# Base Pay (USDC on Base mainnet). Address that receives the USDC.
BASE_PAY_RECIPIENT="0xe8Bda2Ed9d2FC622D900C8a76dc455A3e79B041f"

# Comma-separated allowlist. Only these emails can access /admin.
ADMIN_EMAILS="owner@example.com,second-admin@example.com"

# Optional local-only test grant. Disabled in production unless ENABLE_DEV_GRANT=true and NODE_ENV is not production.
DEV_ADMIN_KEY=""
ENABLE_DEV_GRANT="false"

# Vercel AI Gateway - Grok/X context + image grounding (Starter+ plans)
# Get API key from: Vercel Dashboard → AI Gateway → API Keys → Create Key
# Endpoint is universal (no team slug needed in URL)
AI_GATEWAY_API_KEY="vai_..."
AI_GATEWAY_MODEL="xai/grok-4.1-fast-reasoning"
AI_GATEWAY_GENERATION_MODEL="openai/gpt-5.4-mini"
