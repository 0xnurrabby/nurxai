# NurXai dashboard environment variables.
# Copy to .env.local for development and configure the same keys on Render.
# Secrets belong in Render (or your secret manager), never in Git.
#
# Optional tuning variables are listed at the bottom. They are intentionally
# unset by default because the code ships the same values as defaults.

# Canonical public origin. Use https and no trailing slash in production.
PUBLIC_URL=https://nurxai.xyz
NEXT_PUBLIC_APP_URL=https://nurxai.xyz
STRICT_ENV_VALIDATION=true

# PostgreSQL. DATABASE_URL is the runtime connection. DIRECT_DATABASE_URL is
# optional and preferred for migrations when the runtime URL is pooled.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_DATABASE_URL=

# Auth. Generate each pepper/secret independently with at least 32 characters.
JWT_SECRET=
AUTH_RATE_LIMIT_PEPPER=
OTP_PEPPER=
ADMIN_EMAILS=owner@example.com
SESSION_COOKIE_DOMAIN=nurxai.xyz

# Google sign-in. The dashboard uses the direct Google Identity Services flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_DIRECT_AUTH=true
# Bridge mode only (set NEXT_PUBLIC_GOOGLE_DIRECT_AUTH=false to enable):
# NEXT_PUBLIC_GOOGLE_BRIDGE_ORIGIN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email OTP delivery via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NurAi <no-reply@example.com>

# Vercel AI Gateway. Required for reply generation.
AI_GATEWAY_API_KEY=

# Billing. CRON_SECRET authorizes the scheduled /api/billing/reconcile call.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
CRON_SECRET=
BASE_PAY_RECIPIENT=
BASE_RPC_URL=https://mainnet.base.org

# Chrome Web Store release compatibility.
# Keep MIN_EXTENSION_VERSION at or below the published extension version.
LEGACY_STORE_VERSION=2.0.17
LEGACY_AUTH_FALLBACK_ENABLED=false
MIN_EXTENSION_VERSION=2.0.17

# ── Optional overrides (code defaults shown, leave unset normally) ─────────
# IMAGE_FETCH_TIMEOUT_MS=5500
# AI_GATEWAY_ENRICH_TIMEOUT_MS=12000
# AI_GATEWAY_ENRICH_ATTEMPTS=1
# AI_GATEWAY_ENRICH_MAX_TOKENS=260
# AI_GATEWAY_SEARCH_TIMEOUT_MS=9000
# AI_GATEWAY_SEARCH_PROMPT_CHARS=280
# AI_GATEWAY_SEARCH_MAX_OUTPUT_TOKENS=55
# AI_GATEWAY_SEARCH_CACHE_TTL_HOURS=24
# AI_GATEWAY_GENERATION_TIMEOUT_MS=35000
# MAX_REPLY_CHARS=150
# AI_GATEWAY_MODEL=xai/grok-4.20-non-reasoning
# AI_GATEWAY_GENERATION_MODEL=openai/gpt-5.4-mini
# AI_GATEWAY_SEARCH_MODEL=google/gemini-3.1-flash-lite
# AI_GATEWAY_SEARCH_MODE=auto
# AI_GATEWAY_USAGE_LOOKUP=false

# Pay As You Go (Base x402). Disabled; enabling requires the full set below.
# PAYG_X402_ENABLED=true
# X402_PAY_TO=
# X402_BUILDER_CODE=
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# PAYG_INTERNAL_SECRET=

# Local development only. Never configure these in Production.
# ENABLE_DEV_GRANT=true
# DEV_ADMIN_KEY=
