# Canonical public origin. Use https and no trailing slash in production.
PUBLIC_URL=https://nurxai.xyz
NEXT_PUBLIC_APP_URL=https://nurxai.xyz
STRICT_ENV_VALIDATION=false

# PostgreSQL. DATABASE_URL is the portable runtime default. DIRECT_DATABASE_URL
# is optional and preferred for migrations when the runtime URL is pooled.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_DATABASE_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
MIGRATE_ON_PREVIEW=false
# Emergency-only opt-out for non-production builds without a database.
SKIP_MIGRATIONS=false

# Auth. Generate each pepper/secret independently with at least 32 characters.
JWT_SECRET=
AUTH_RATE_LIMIT_PEPPER=
OTP_PEPPER=
ADMIN_EMAILS=owner@example.com
SESSION_COOKIE_DOMAIN=nurxai.xyz
SESSION_COOKIE_SECURE=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_DIRECT_AUTH=true
NEXT_PUBLIC_GOOGLE_BRIDGE_ORIGIN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=NurAi <no-reply@example.com>

# Existing Chrome Web Store release compatibility.
LEGACY_STORE_VERSION=2.0.17
LEGACY_AUTH_CHECK_URL=https://nurxai.nurw3b.workers.dev/api/announcements
LEGACY_AUTH_FALLBACK_ENABLED=true
MIN_EXTENSION_VERSION=2.0.17
EXTENSION_UPDATE_URL=https://chromewebstore.google.com/detail/odapbgkbdpalphekkmibliclmedgmlhb

# Vercel AI Gateway.
AI_GATEWAY_API_KEY=
AI_GATEWAY_GENERATION_MODEL=openai/gpt-5.4-mini
AI_GATEWAY_MODEL=xai/grok-4.20-non-reasoning
AI_GATEWAY_SEARCH_MODEL=google/gemini-3.1-flash-lite
AI_GATEWAY_SEARCH_MODE=auto
AI_GATEWAY_USAGE_LOOKUP=false
IMAGE_FETCH_TIMEOUT_MS=5500
AI_GATEWAY_ENRICH_TIMEOUT_MS=12000
AI_GATEWAY_ENRICH_ATTEMPTS=1
AI_GATEWAY_ENRICH_MAX_TOKENS=260
AI_GATEWAY_SEARCH_TIMEOUT_MS=9000
AI_GATEWAY_SEARCH_PROMPT_CHARS=280
AI_GATEWAY_SEARCH_MAX_OUTPUT_TOKENS=55
AI_GATEWAY_SEARCH_CACHE_TTL_HOURS=24
AI_GATEWAY_GENERATION_TIMEOUT_MS=35000
MAX_REPLY_CHARS=150

# Billing. CRON_SECRET is used by the daily Vercel cron in vercel.json.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_JWT_TOKEN=
BILLING_RECONCILE_SECRET=
CRON_SECRET=
BASE_PAY_RECIPIENT=

# x402 Pay As You Go on Base mainnet.
PAYG_X402_ENABLED=false
NEXT_PUBLIC_PAYG_ENABLED=false
X402_PAY_TO=
X402_BUILDER_CODE=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
PAYG_INTERNAL_SECRET=
BASE_RPC_URL=https://mainnet.base.org

# Local development only. Never configure these in Production.
ENABLE_DEV_GRANT=false
DEV_ADMIN_KEY=
