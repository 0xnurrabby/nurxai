generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String?
  googleId        String?        @unique
  authProvider    String         @default("password")
  name            String?
  avatarUrl       String?        @db.Text
  isAdmin         Boolean        @default(false)
  // Personalization
  replyStyle      String         @default("default") // default, funny, short, productive, professional, witty
  customStyleNote String?        @db.Text // optional user's own style note
  createdAt       DateTime       @default(now())
  subscriptions   Subscription[]
  usage           UsageLog[]
  payments        Payment[]
  projects        Project[]
  generations     Generation[]
  announcementReads AnnouncementRead[]
  chatMessages    ChatMessage[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  status    String
  dailyLimit Int?
  startsAt  DateTime @default(now())
  endsAt    DateTime
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model UsageLog {
  id     String @id @default(cuid())
  userId String
  day    String
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, day])
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  provider   String   // "nowpayments" | "basepay"
  providerId String   @unique // NOWP order_id, or our basepay orderId
  providerPaymentId String? // NOWPayments invoice/payment id, when available
  amount     Decimal
  currency   String
  plan       String
  status     String   // "waiting" | "confirmed" | "failed"
  txHash     String?  // base mainnet tx hash (basepay only)
  payerAddr  String?  // sender address (basepay only)
  raw        Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([txHash])
  @@index([providerPaymentId])
}

model Project {
  id        String          @id @default(cuid())
  userId    String
  name      String
  contexts  ProjectContext[]
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProjectContext {
  id        String   @id @default(cuid())
  projectId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Generation {
  id            String   @id @default(cuid())
  userId        String
  contextHash   String
  suggestions   Json
  usageDetails  Json?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costUSD       Decimal  @default(0)
  model         String
  hadImage      Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, contextHash])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
}

model Announcement {
  id        String             @id @default(cuid())
  title     String?
  body      String             @db.Text
  createdAt DateTime           @default(now())
  createdBy String?
  reads     AnnouncementRead[]

  @@index([createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}
