generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String?
  googleId        String?        @unique
  authProvider    String         @default("password")
  name            String?
  avatarUrl       String?        @db.Text
  chatReadAt      DateTime?
  isAdmin         Boolean        @default(false)
  sessionVersion  Int            @default(0)
  referralCode    String?        @unique
  referredById    String?
  referredAt      DateTime?
  // Personalization
  replyStyle      String         @default("default") // default, funny, short, productive, professional, witty
  customStyleNote String?        @db.Text // optional user's own style note
  createdAt       DateTime       @default(now())
  referredBy      User?          @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]         @relation("UserReferrals")
  subscriptions   Subscription[]
  usage           UsageLog[]
  payments        Payment[]
  projects        Project[]
  generations     Generation[]
  announcementReads AnnouncementRead[]
  chatMessages    ChatMessage[]
  subscriptionGifts SubscriptionGift[]
  walletLedger    WalletLedger[]
  withdrawals     WithdrawalRequest[]
  paygGenerations PaygGeneration[]

  @@index([referredById])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  status    String
  dailyLimit Int?
  startsAt  DateTime @default(now())
  endsAt    DateTime
  user      User     @relation(fields: [userId], references: [id])
  gifts     SubscriptionGift[]

  @@index([userId, status])
}

model SubscriptionGift {
  id             String       @id @default(cuid())
  userId         String
  subscriptionId String
  adminId        String?
  days           Int
  note           String?      @db.Text
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([active, createdAt])
}

model UsageLog {
  id     String @id @default(cuid())
  userId String
  day    String
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, day])
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  provider   String   // "nowpayments" | "basepay"
  providerId String   @unique // NOWP order_id, or our basepay orderId
  providerPaymentId String? // NOWPayments invoice/payment id, when available
  amount     Decimal
  currency   String
  plan       String
  status     String   // "waiting" | "confirmed" | "failed"
  txHash     String?  // base mainnet tx hash (basepay only)
  payerAddr  String?  // sender address (basepay only)
  raw        Json?
  createdAt  DateTime @default(now())
  lastReconciledAt DateTime?
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([txHash])
  @@index([providerPaymentId])
  @@index([provider, status, lastReconciledAt])
}

model EmailOtpChallenge {
  id         String    @id
  email      String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  sentAt     DateTime?
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([email, purpose])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Project {
  id        String          @id @default(cuid())
  userId    String
  name      String
  contexts  ProjectContext[]
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProjectContext {
  id        String   @id @default(cuid())
  projectId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Generation {
  id            String   @id @default(cuid())
  userId        String
  contextHash   String
  suggestions   Json
  usageDetails  Json?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costUSD       Decimal  @default(0)
  model         String
  hadImage      Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, contextHash])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
}

model Announcement {
  id        String             @id @default(cuid())
  title     String?
  body      String             @db.Text
  createdAt DateTime           @default(now())
  createdBy String?
  reads     AnnouncementRead[]

  @@index([createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model WalletLedger {
  id          String   @id @default(cuid())
  userId      String
  amountUSD   Decimal
  type        String
  sourceType  String?
  sourceId    String?
  note        String?  @db.Text
  adminId     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@unique([sourceType, sourceId])
}

model WithdrawalRequest {
  id            String   @id @default(cuid())
  userId        String
  amountUSD     Decimal
  network       String   @default("BEP20_USDT")
  address       String
  status        String   @default("pending")
  userNote      String?  @db.Text
  adminNote     String?  @db.Text
  txHash        String?
  paidAt        DateTime?
  rejectedAt    DateTime?
  noticeSeenAt  DateTime?
  noticeClearAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([noticeClearAt])
}

model PaygGeneration {
  id             String   @id
  userId         String
  requestHash    String
  status         String
  authorizationId String? @unique
  leaseToken     String?
  leaseExpiresAt DateTime?
  settlementStartBlock BigInt?
  pricingRevision Int      @default(1)
  quotedRegularPriceUSD Decimal @default(0.009) @db.Decimal(12, 6)
  quotedCurrentPriceUSD Decimal @default(0.009) @db.Decimal(12, 6)
  quotedAmountAtomic String @default("9000")
  quotedNetwork  String   @default("eip155:8453")
  quotedAsset    String   @default("0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913")
  quotedPayTo    String   @default("0xe8Bda2Ed9d2FC622D900C8a76dc455A3e79B041f")
  payer          String?
  transactionHash String?  @unique
  settlement     Json?
  response       Json?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([status, leaseExpiresAt])
}

model PaygPricing {
  id              String   @id
  regularPriceUSD Decimal  @db.Decimal(12, 6)
  currentPriceUSD Decimal  @db.Decimal(12, 6)
  revision        Int      @default(1)
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
