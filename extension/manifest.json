{
  "manifest_version": 3,
  "name": "NurXai - AI Reply for X",
  "version": "2.0.3",
  "description": "AI-powered, human-like reply suggestions for X/Twitter.",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "19": "icons/icon-19.png",
    "38": "icons/icon-38.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "19": "icons/icon-19.png",
      "38": "icons/icon-38.png"
    },
    "default_title": "NurAi"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["scripts/contentscript.js"],
      "css": ["styles/nurai.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.nurxai.xyz/*"
  ],
  "externally_connectable": {
    "matches": ["https://www.nurxai.xyz/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.nurxai.xyz"
  }
}
